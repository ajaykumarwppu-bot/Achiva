# ============================================================
#  Achiva — .gitignore
#  Repo PUBLIC hai, isliye secrets wala section sabse zaroori hai
# ============================================================

# ---------- 🔐 SECRETS / TOKENS  (sabse important) ----------
# Ye patterns galti se bhi commit na ho jaayein.
.gh-token
.github-token
.gh_token
gh-token.txt
token.txt
*.token
*-token.txt
token-*.txt
secrets/
secrets.*
credentials.json
serviceAccount*.json
*.pem
*.key
*.p12
*.keystore
*.jks
keystore.properties
signing.properties

# Environment files
.env
.env.*
!.env.example
*.env
*.env.local

# Firebase / backend local config overrides
# NOTE: backend/firebase-config.js JAAN-BOOJH kar ignore NAHI kiya —
#       REPO-GUIDE.md ke mutabik GitHub Pages usi se chalti hai.
backend/firebase-config.local.js
backend/email-config.local.js
*-secret.js
*-secret.json

# ---------- 📦 Node / build output ----------
node_modules/
dist/
build/
out/
target/
coverage/
.next/
.nuxt/
.output/
.parcel-cache/
.vite/
.turbo/
.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 🤖 Android / Gradle ----------
.gradle/
android-app/.gradle/
android-app/local.properties
android-app/build/
android-app/app/build/
android-app/.idea/
android-app/captures/
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties

# ---------- 🧪 Test / lint / type caches ----------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/

# ---------- 💻 OS junk ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- ✏️ Editors ----------
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
*.sublime-workspace
*.sublime-project

# ---------- 🗂️ Temp / uploads / logs ----------
tmp/
temp/
uploads/
*.log
*.tmp
*.bak
*.orig
*.rej
