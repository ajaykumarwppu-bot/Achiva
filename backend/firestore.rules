rules_version = '2';

/* ================================================================
   FIRESTORE.RULES — achiva ka data lock
   ----------------------------------------------------------------
   • Har user SIRF apna data (users/<apna-uid>/...) padh/likh sakta hai.
   • Bina login koi kuch nahi padh sakta.
   • Baaki poori database default deny.

   Deploy (do mein se ek tarika):
     A) Firebase Console → Firestore Database → Rules → ye poora text
        paste karein → Publish
     B) firebase CLI:  firebase deploy --only firestore:rules
        (is file ka naam firestore.rules hona chahiye aur
         firebase.json mein "firestore": {"rules": "backend/firestore.rules"} )

   Note: ye file website par deploy NAHI hoti — sirf Firebase ke liye hai.
   ================================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---- login ke bina kuch bhi nahi ---- */
    match /{document=**} {
      allow read, write: if false;
    }

    /* ---- sirf apna data (profile doc = users/<uid> , backup docs = users/<uid>/data/*) ---- */
    match /users/{uid} {
      /* profile doc khud (users/<uid>) — sirf malik */
      allow read, write: if request.auth != null && request.auth.uid == uid;

      /* backup docs — sirf malik.
         NOTE: read aur write ALAG hain, kyunki 'request.resource' sirf WRITE par
         exist karta hai; read par wo undefined hota hai aur combined condition
         read ko deny kar deti thi (isi se restore 'permission denied' hota tha). */
      match /data/{docId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;

        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasAll(['v', 'savedAt', 'value'])
                     && request.resource.data.value is string
                     && request.resource.data.value.size() <= 900000;
      }
    }
  }
}
